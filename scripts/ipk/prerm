#!/bin/sh
# Pre-removal script for nym-vpn IPK package

# Upgrade only: remember what rpcd is currently serving. postinst compares
# this against the new package to pick the least disruptive rpcd refresh
# (see there); a missing stash makes it restart rpcd.
#
# The plugin file /usr/libexec/rpcd/nym-vpn is a fixed wrapper around
# `nym-vpnc rpcd`, so its checksum never changes; what rpcd caches at start
# is the method list that wrapper prints for `list`. Hash that output (from
# the binary still installed here). Empty when `list` fails, which postinst
# reads as "changed".
nym_rpcd_schema_hash() {
    local out
    out=$(/usr/libexec/rpcd/nym-vpn list 2>/dev/null) || return 0
    [ -n "$out" ] || return 0
    printf '%s\n' "$out" | md5sum | cut -d' ' -f1
}
# The stash lives under /var/run (root-owned 0755 on OpenWrt), not /tmp: a
# predictable world-writable path could be pre-created as a FIFO and hang
# this script at the redirect, or seeded with content. Remove any stale
# entry first so the redirect always creates a fresh regular file.
nym_rpcd_state=/var/run/nym-vpn.rpcd-state
rm -f "$nym_rpcd_state" /tmp/nym-vpn.rpcd-state 2>/dev/null
if [ "$PKG_UPGRADE" = "1" ]; then
    {
        echo "plugin=$(nym_rpcd_schema_hash)"
        echo "acl=$(md5sum /usr/share/rpcd/acl.d/luci-app-nym-vpn.json 2>/dev/null | cut -d' ' -f1)"
    } > "$nym_rpcd_state"
fi

# Stop the watchdog: it would fight the restart postinst does. On an upgrade
# the daemon itself keeps running through the file swap (Linux keeps the old
# binary alive on its unlinked inode) and postinst restarts it through the
# newly installed init script, whose restart path keeps the kill-switch
# armed. The init script on disk at this point is the old package's, so
# nothing here relies on what its stop would do. Real removal stops both.
/etc/init.d/nym-vpn-watchdog stop 2>/dev/null
if [ "$PKG_UPGRADE" != "1" ]; then
    /etc/init.d/nym-vpnd stop 2>/dev/null
fi

# Disabling is for real removal only. On an upgrade the boot symlinks must
# survive: postinst re-creates them, but if postinst never runs (a failed or
# interrupted transaction, or a package manager that skips post-upgrade) the
# router is left with the service permanently disabled — it does not come back
# after a reboot either, and the UI then shows an empty account, which reads as
# lost credentials. Leaving /etc/rc.d alone makes that failure self-healing.
if [ "$PKG_UPGRADE" != "1" ]; then
    /etc/init.d/nym-vpn-watchdog disable 2>/dev/null
    /etc/init.d/nym-vpnd disable 2>/dev/null
fi

# Firewall teardown is for real removal only. On an upgrade the daemon's
# policy, the boot block and the fw3 rules files stay: the new daemon
# replaces them atomically on its first apply (fw4 re-creates its table and
# adds jumps only when absent; fw3 restores over existing chains), and
# tearing them down here would open WAN egress for the whole transaction.
if [ "$PKG_UPGRADE" != "1" ]; then

# The boot-time kill-switch block (fw4-include.sh, fw-boot-guard.sh) must not
# outlive the package: with the daemon gone nothing else would ever lift it.
# An nftables table filters on its own whether fw4 is the active backend or
# not, so remove it wherever nft exists instead of trusting the backend guess
# below. The fw3 counterpart shares the NYM_EMERGENCY_* chains removed there.
if command -v nft >/dev/null 2>&1; then
    nft delete table inet nym_boot 2>/dev/null
fi

# Clean up firewall rules (backend decided by the shared detector so this
# cannot disagree with the include registration)
if [ -x /usr/share/nym-vpn/fw-backend.sh ]; then
    nym_fw_backend="$(/usr/share/nym-vpn/fw-backend.sh)"
elif [ -x /sbin/fw4 ] || [ -x /usr/sbin/fw4 ]; then
    nym_fw_backend="fw4"
else
    nym_fw_backend="fw3"
fi
if [ "$nym_fw_backend" = "fw4" ]; then
    # fw4/nftables cleanup
    nft delete table inet nym 2>/dev/null
    # Remove rules from fw4 chains (srcnat, forward_lan)
    for chain in srcnat forward_lan; do
        handles=$(nft -a list chain inet fw4 "$chain" 2>/dev/null | grep "nym-vpn:" | sed 's/.*handle //')
        for h in $handles; do
            nft delete rule inet fw4 "$chain" handle "$h" 2>/dev/null
        done
    done
else
    # fw3/iptables cleanup
    for ipt in iptables ip6tables; do
        # Remove jump rules from fw3 hook chains
        for hook in input_rule output_rule forwarding_rule; do
            $ipt -D "$hook" -j NYM_INPUT 2>/dev/null
            $ipt -D "$hook" -j NYM_OUTPUT 2>/dev/null
            $ipt -D "$hook" -j NYM_FORWARD 2>/dev/null
        done
        # Remove jump rules from mangle table built-ins (inbound exemption)
        $ipt -t mangle -D PREROUTING -j NYM_MANGLE_PREROUTING 2>/dev/null
        $ipt -t mangle -D OUTPUT -j NYM_MANGLE_OUTPUT 2>/dev/null
        # Remove forwarding-plane and transition-emergency jumps.
        $ipt -D forwarding_rule -j NYM_FORWARD_LAN 2>/dev/null
        while $ipt -D output_rule -j NYM_EMERGENCY_OUT 2>/dev/null; do :; done
        while $ipt -D forwarding_rule -j NYM_EMERGENCY_FWD 2>/dev/null; do :; done
        # Flush and delete our chains in filter + mangle
        for chain in NYM_INPUT NYM_OUTPUT NYM_FORWARD NYM_FORWARD_LAN \
            NYM_EMERGENCY_OUT NYM_EMERGENCY_FWD; do
            $ipt -F "$chain" 2>/dev/null
            $ipt -X "$chain" 2>/dev/null
        done
        for chain in NYM_MANGLE_PREROUTING NYM_MANGLE_OUTPUT; do
            $ipt -t mangle -F "$chain" 2>/dev/null
            $ipt -t mangle -X "$chain" 2>/dev/null
        done
    done
    # Remove masquerade rules from NAT table
    for num in $(iptables -t nat -L POSTROUTING -n --line-numbers -v 2>/dev/null | grep "nym-vpn" | awk '{print $1}' | sort -rn); do
        iptables -t nat -D POSTROUTING "$num" 2>/dev/null
    done
fi

# The runtime-state directory (RUNTIME_DIR in the firewall backends; rules
# files, transition marker, lock, stop marker) is the includes' reload state.
# Removal only, for the same reason. The /tmp names are what versions before
# the runtime directory used; nothing reads them any more.
rm -rf /var/run/nym-firewall 2>/dev/null
rm -f /tmp/nym-firewall-v4.rules /tmp/nym-firewall-v6.rules /tmp/nym-firewall.nft \
    /tmp/nym-firewall.ifaces /tmp/nym-firewall.transition /tmp/nym-firewall.lock \
    /tmp/nym-vpnd.stopped /tmp/nym-vpnd.stop-pid 2>/dev/null

fi # PKG_UPGRADE != 1

# Defensive: flush any stray ip rule entries our daemon may have installed.
# These are normally cleared by the daemon's clear_routing_rules() on stop,
# but a crashed daemon can leave them behind. Match by our specific fwmark
# values rather than priority to avoid touching unrelated rules. Removal
# only: on an upgrade the daemon is still running and owns these rules
# (inbound-exemption replies route through the 0x14e one), and the new
# daemon re-creates them when postinst restarts it.
if [ "$PKG_UPGRADE" != "1" ]; then
    for ip_cmd in "ip" "ip -6"; do
        while $ip_cmd rule del fwmark 0x14d lookup 333 2>/dev/null; do :; done
        while $ip_cmd rule del fwmark 0x14e lookup main 2>/dev/null; do :; done
    done
fi

# Remove the UCI firewall include on real removal only. On an upgrade
# postinst reconciles it, but if postinst never runs (interrupted
# transaction) a deleted section would leave the kill-switch unable to
# survive a firewall reload with nothing to repair it until the next
# install. Leaving it in place is self-healing.
if [ "$PKG_UPGRADE" != "1" ]; then
    uci delete firewall.nym_vpn 2>/dev/null
    uci commit firewall 2>/dev/null
fi

# Clean up temporary files (safe on both upgrade and removal)
rm -f /tmp/dnsmasq.d/nym-adblock.conf 2>/dev/null
rm -f /tmp/nym-dns-backup /tmp/resolv.conf.nymbackup 2>/dev/null
rm -f /var/run/nym-watchdog.state /tmp/nym-watchdog.state 2>/dev/null

# DNS: on full removal, return dnsmasq to stock resolv handling. On upgrade,
# leave everything in place — the new daemon reconverges without a restart
# and a dnsmasq restart here would be a pointless LAN-wide DNS outage.
if [ "$PKG_UPGRADE" != "1" ]; then
    # Staged (uncommitted) repoint: targeted revert only — never wholesale,
    # so the user's own staged dhcp edits survive.
    uci -q revert dhcp.@dnsmasq[0].resolvfile
    # Accidentally-committed repoint (LuCI Save&Apply commits staged deltas):
    # deleting the option restores the stock default resolvfile.
    if grep -q "nym-resolv.conf" /etc/config/dhcp 2>/dev/null; then
        uci -q delete dhcp.@dnsmasq[0].resolvfile
        uci -q commit dhcp
    fi
    rm -f /tmp/resolv.conf.d/nym-resolv.conf /tmp/resolv.conf.d/.nym-resolv.tmp 2>/dev/null
    # Restart only if the running instance still points at our (now removed) file.
    if grep -qs "resolv-file=.*nym-resolv.conf" /var/etc/dnsmasq.conf.* 2>/dev/null; then
        /etc/init.d/dnsmasq restart 2>/dev/null
    fi
fi

# Only do destructive cleanup on full removal, not upgrades.
# opkg sets PKG_UPGRADE=1 when upgrading.
if [ "$PKG_UPGRADE" != "1" ]; then
    rm -rf /etc/nym 2>/dev/null
    rm -rf /var/log/nym-vpnd 2>/dev/null
    rm -f /var/run/nym-vpn.rpcd-state 2>/dev/null

    # Remove package feed registration
    if [ -f /etc/opkg/customfeeds.conf ]; then
        sed -i '/nym-vpn/d' /etc/opkg/customfeeds.conf 2>/dev/null
    fi
    rm -f /etc/apk/repositories.d/nym-vpn.list 2>/dev/null
fi

exit 0
