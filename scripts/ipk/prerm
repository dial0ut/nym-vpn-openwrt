#!/bin/sh
# Pre-removal script for nym-vpn IPK package

# Stop the services: the binaries are about to be replaced either way.
/etc/init.d/nym-vpn-watchdog stop 2>/dev/null
/etc/init.d/nym-vpnd stop 2>/dev/null

# Disabling is for real removal only. On an upgrade the boot symlinks must
# survive: postinst re-creates them, but if postinst never runs (a failed or
# interrupted transaction, or a package manager that skips post-upgrade) the
# router is left with the service permanently disabled — it does not come back
# after a reboot either, and the UI then shows an empty account, which reads as
# lost credentials. Leaving /etc/rc.d alone makes that failure self-healing.
if [ "$PKG_UPGRADE" != "1" ]; then
    /etc/init.d/nym-vpn-watchdog disable 2>/dev/null
    /etc/init.d/nym-vpnd disable 2>/dev/null
fi

# Clean up firewall rules
if [ -x /sbin/fw4 ]; then
    # fw4/nftables cleanup
    nft delete table inet nym 2>/dev/null
    # Remove rules from fw4 chains (srcnat, forward_lan)
    for chain in srcnat forward_lan; do
        handles=$(nft -a list chain inet fw4 "$chain" 2>/dev/null | grep "nym-vpn:" | sed 's/.*handle //')
        for h in $handles; do
            nft delete rule inet fw4 "$chain" handle "$h" 2>/dev/null
        done
    done
else
    # fw3/iptables cleanup
    for ipt in iptables ip6tables; do
        # Remove jump rules from fw3 hook chains
        for hook in input_rule output_rule forwarding_rule; do
            $ipt -D "$hook" -j NYM_INPUT 2>/dev/null
            $ipt -D "$hook" -j NYM_OUTPUT 2>/dev/null
            $ipt -D "$hook" -j NYM_FORWARD 2>/dev/null
        done
        # Remove jump rules from mangle table built-ins (inbound exemption)
        $ipt -t mangle -D PREROUTING -j NYM_MANGLE_PREROUTING 2>/dev/null
        $ipt -t mangle -D OUTPUT -j NYM_MANGLE_OUTPUT 2>/dev/null
        # Remove the forwarding-plane jump (kill-switch on and off states)
        $ipt -D forwarding_rule -j NYM_FORWARD_LAN 2>/dev/null
        # Flush and delete our chains in filter + mangle
        for chain in NYM_INPUT NYM_OUTPUT NYM_FORWARD NYM_FORWARD_LAN; do
            $ipt -F "$chain" 2>/dev/null
            $ipt -X "$chain" 2>/dev/null
        done
        for chain in NYM_MANGLE_PREROUTING NYM_MANGLE_OUTPUT; do
            $ipt -t mangle -F "$chain" 2>/dev/null
            $ipt -t mangle -X "$chain" 2>/dev/null
        done
    done
    # Remove masquerade rules from NAT table
    for num in $(iptables -t nat -L POSTROUTING -n --line-numbers -v 2>/dev/null | grep "nym-vpn" | awk '{print $1}' | sort -rn); do
        iptables -t nat -D POSTROUTING "$num" 2>/dev/null
    done
fi

# Defensive: flush any stray ip rule entries our daemon may have installed.
# These are normally cleared by the daemon's clear_routing_rules() on stop,
# but a crashed daemon can leave them behind. Match by our specific fwmark
# values rather than priority to avoid touching unrelated rules.
for ip_cmd in "ip" "ip -6"; do
    while $ip_cmd rule del fwmark 0x14d lookup 333 2>/dev/null; do :; done
    while $ip_cmd rule del fwmark 0x14e lookup main 2>/dev/null; do :; done
done

# Remove UCI firewall include config
uci delete firewall.nym_vpn 2>/dev/null
uci commit firewall 2>/dev/null

# Clean up temporary files (safe on both upgrade and removal)
rm -f /tmp/nym-firewall-v4.rules /tmp/nym-firewall-v6.rules /tmp/nym-firewall.nft \
    /tmp/nym-firewall.ifaces 2>/dev/null
rm -f /tmp/dnsmasq.d/nym-adblock.conf 2>/dev/null
rm -f /tmp/nym-dns-backup /tmp/resolv.conf.nymbackup 2>/dev/null
rm -f /tmp/nym-watchdog.state 2>/dev/null

# DNS: on full removal, return dnsmasq to stock resolv handling. On upgrade,
# leave everything in place — the new daemon reconverges without a restart
# and a dnsmasq restart here would be a pointless LAN-wide DNS outage.
if [ "$PKG_UPGRADE" != "1" ]; then
    # Staged (uncommitted) repoint: targeted revert only — never wholesale,
    # so the user's own staged dhcp edits survive.
    uci -q revert dhcp.@dnsmasq[0].resolvfile
    # Accidentally-committed repoint (LuCI Save&Apply commits staged deltas):
    # deleting the option restores the stock default resolvfile.
    if grep -q "nym-resolv.conf" /etc/config/dhcp 2>/dev/null; then
        uci -q delete dhcp.@dnsmasq[0].resolvfile
        uci -q commit dhcp
    fi
    rm -f /tmp/resolv.conf.d/nym-resolv.conf /tmp/resolv.conf.d/.nym-resolv.tmp 2>/dev/null
    # Restart only if the running instance still points at our (now removed) file.
    if grep -qs "resolv-file=.*nym-resolv.conf" /var/etc/dnsmasq.conf.* 2>/dev/null; then
        /etc/init.d/dnsmasq restart 2>/dev/null
    fi
fi

# Only do destructive cleanup on full removal, not upgrades.
# opkg sets PKG_UPGRADE=1 when upgrading.
if [ "$PKG_UPGRADE" != "1" ]; then
    rm -rf /etc/nym 2>/dev/null
    rm -rf /var/log/nym-vpnd 2>/dev/null

    # Remove package feed registration
    if [ -f /etc/opkg/customfeeds.conf ]; then
        sed -i '/nym-vpn/d' /etc/opkg/customfeeds.conf 2>/dev/null
    fi
    rm -f /etc/apk/repositories.d/nym-vpn.list 2>/dev/null
fi

exit 0
