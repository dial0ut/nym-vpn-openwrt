#!/bin/sh
# Pre-removal script for nym-vpn IPK package

# Upgrade only: stash what rpcd currently serves so postinst can pick the
# least disruptive refresh. The plugin file is a fixed wrapper around
# `nym-vpnc rpcd`, so hash its `list` output, not the file. Empty when
# `list` fails, which postinst reads as "changed".
nym_rpcd_schema_hash() {
    local out
    out=$(/usr/libexec/rpcd/nym-vpn list 2>/dev/null) || return 0
    [ -n "$out" ] || return 0
    printf '%s\n' "$out" | md5sum | cut -d' ' -f1
}
# Under /var/run, not /tmp: a pre-created FIFO at a world-writable path would
# hang the redirect. Remove stale entries so it always creates a fresh file.
nym_rpcd_state=/var/run/nym-vpn.rpcd-state
rm -f "$nym_rpcd_state" /tmp/nym-vpn.rpcd-state 2>/dev/null
if [ "$PKG_UPGRADE" = "1" ]; then
    {
        echo "plugin=$(nym_rpcd_schema_hash)"
        echo "acl=$(md5sum /usr/share/rpcd/acl.d/luci-app-nym-vpn.json 2>/dev/null | cut -d' ' -f1)"
    } > "$nym_rpcd_state"
fi

# On an upgrade the daemon keeps running through the file swap; postinst
# restarts it via the new init script, whose restart path keeps the
# kill-switch armed.
if [ "$PKG_UPGRADE" != "1" ]; then
    /etc/init.d/nym-vpnd stop 2>/dev/null
fi

# Removal only: if postinst never runs after an upgrade (interrupted
# transaction), a disabled service would stay disabled across reboots.
if [ "$PKG_UPGRADE" != "1" ]; then
    /etc/init.d/nym-vpnd disable 2>/dev/null
fi

# Removal only: on an upgrade the policy, boot block and fw3 rules files stay
# and the new daemon replaces them atomically on its first apply. Tearing
# them down here would open WAN egress for the whole transaction.
if [ "$PKG_UPGRADE" != "1" ]; then

# An nftables table filters regardless of the active backend, so remove the
# boot block wherever nft exists rather than trusting the backend guess.
if command -v nft >/dev/null 2>&1; then
    nft delete table inet nym_boot 2>/dev/null
fi

# The guard is the one fw3/fw4 detector, shared with the include
# registration and the init script, so the three cannot disagree. The
# package's files are still on disk while prerm runs.
NYM_SHARE_DIR="${NYM_SHARE_DIR:-/usr/share/nym-vpn}"
if [ -r "$NYM_SHARE_DIR/fw-boot-guard.sh" ]; then
    # shellcheck source=/dev/null
    . "$NYM_SHARE_DIR/fw-boot-guard.sh"
    nym_fw_backend="$(nym_fw_backend)"
else
    logger -t nym-vpn "CRITICAL: $NYM_SHARE_DIR/fw-boot-guard.sh is missing; tearing down the fw3 chains blind"
    nym_fw_backend=""
fi
if [ "$nym_fw_backend" = "fw4" ]; then
    # No lock on fw4: one atomic transaction, and the include never touches
    # `inet nym`. The include cannot re-arm the boot block after this: the
    # `disable` above removed the rc.d link its guard requires, and the uci
    # include section goes below. Nothing of ours is inside `inet fw4`.
    nft delete table inet nym 2>/dev/null
else
    # The include owns the fw3 teardown (stop marker present: discard
    # persisted state, remove chains and jumps). The init script's stop
    # already ran it under the lock; run it once more the same way so a
    # stop that could not take the lock is completed here. The inline
    # fallback is for an install whose include or guard is gone.
    nym_fw3_teardown_inline() {
        for ipt in iptables ip6tables; do
            for hook in input_rule output_rule forwarding_rule; do
                $ipt -D "$hook" -j NYM_INPUT 2>/dev/null
                $ipt -D "$hook" -j NYM_OUTPUT 2>/dev/null
                $ipt -D "$hook" -j NYM_FORWARD 2>/dev/null
            done
            $ipt -t mangle -D PREROUTING -j NYM_MANGLE_PREROUTING 2>/dev/null
            $ipt -t mangle -D OUTPUT -j NYM_MANGLE_OUTPUT 2>/dev/null
            while $ipt -D output_rule -j NYM_EMERGENCY_OUT 2>/dev/null; do :; done
            while $ipt -D forwarding_rule -j NYM_EMERGENCY_FWD 2>/dev/null; do :; done
            for chain in NYM_INPUT NYM_OUTPUT NYM_FORWARD \
                NYM_EMERGENCY_OUT NYM_EMERGENCY_FWD; do
                $ipt -F "$chain" 2>/dev/null
                $ipt -X "$chain" 2>/dev/null
            done
            for chain in NYM_MANGLE_PREROUTING NYM_MANGLE_OUTPUT; do
                $ipt -t mangle -F "$chain" 2>/dev/null
                $ipt -t mangle -X "$chain" 2>/dev/null
            done
        done
    }
    if [ -n "$nym_fw_backend" ] \
        && [ -x "$NYM_SHARE_DIR/fw3-include.sh" ] \
        && command -v flock >/dev/null 2>&1; then
        (
            nym_runtime_dir_prepare || exit 1
            touch "$NYM_VPND_STOPPED" 2>/dev/null || exit 1
            exec 9>"$NYM_RUNTIME_DIR/lock"
            flock 9 || exit 1
            NYM_FW_LOCKED=1 "$NYM_SHARE_DIR/fw3-include.sh" 2>/dev/null
        ) || nym_fw3_teardown_inline
    else
        nym_fw3_teardown_inline
    fi
fi

# The /tmp names predate the runtime directory; nothing reads them any more.
rm -rf /var/run/nym-firewall 2>/dev/null
rm -f /tmp/nym-firewall-v4.rules /tmp/nym-firewall-v6.rules /tmp/nym-firewall.nft \
    /tmp/nym-firewall.ifaces /tmp/nym-firewall.transition /tmp/nym-firewall.lock \
    /tmp/nym-vpnd.stopped /tmp/nym-vpnd.stop-pid 2>/dev/null

fi # PKG_UPGRADE != 1

# ip rules a crashed daemon may have left. Matched by our fwmarks, not by
# priority, so unrelated rules are untouched. Removal only: on an upgrade the
# running daemon still owns them.
if [ "$PKG_UPGRADE" != "1" ]; then
    for ip_cmd in "ip" "ip -6"; do
        while $ip_cmd rule del fwmark 0x14d lookup 333 2>/dev/null; do :; done
        while $ip_cmd rule del fwmark 0x14e lookup main 2>/dev/null; do :; done
    done
fi

# Removal only: postinst reconciles the include and the zone on upgrade, and
# if it never runs a deleted section would leave nothing to survive a
# firewall reload. Only the sections uci-defaults named are removed; a zone
# the administrator declared under the same name stays. The reload drops the
# zone's rules; the include section is already gone, so it does not run.
if [ "$PKG_UPGRADE" != "1" ]; then
    uci delete firewall.nym_vpn 2>/dev/null
    uci -q delete firewall.nym_lan_fwd
    uci -q delete firewall.nym_zone
    uci commit firewall 2>/dev/null
    if [ -x /etc/init.d/firewall ]; then
        /etc/init.d/firewall reload >/dev/null 2>&1
    fi
fi

rm -f /tmp/dnsmasq.d/nym-adblock.conf 2>/dev/null
rm -f /tmp/nym-dns-backup /tmp/resolv.conf.nymbackup 2>/dev/null
# State file of the retired shell watchdog (<= 1.34.x).
rm -f /var/run/nym-watchdog.state /tmp/nym-watchdog.state 2>/dev/null

# Removal only: on an upgrade the new daemon reconverges DNS without a
# restart, and a dnsmasq restart here would be a LAN-wide outage.
if [ "$PKG_UPGRADE" != "1" ]; then
    # Targeted revert so the user's own staged dhcp edits survive.
    uci -q revert dhcp.@dnsmasq[0].resolvfile
    # LuCI Save&Apply may have committed the staged repoint.
    if grep -q "nym-resolv.conf" /etc/config/dhcp 2>/dev/null; then
        uci -q delete dhcp.@dnsmasq[0].resolvfile
        uci -q commit dhcp
    fi
    rm -f /tmp/resolv.conf.d/nym-resolv.conf /tmp/resolv.conf.d/.nym-resolv.tmp 2>/dev/null
    if grep -qs "resolv-file=.*nym-resolv.conf" /var/etc/dnsmasq.conf.* 2>/dev/null; then
        /etc/init.d/dnsmasq restart 2>/dev/null
    fi
fi

# opkg sets PKG_UPGRADE=1 on upgrade; build-apk.sh exports it for apk.
if [ "$PKG_UPGRADE" != "1" ]; then
    rm -rf /etc/nym 2>/dev/null
    rm -rf /var/log/nym-vpnd 2>/dev/null
    rm -f /var/run/nym-vpn.rpcd-state 2>/dev/null

    if [ -f /etc/opkg/customfeeds.conf ]; then
        sed -i '/nym-vpn/d' /etc/opkg/customfeeds.conf 2>/dev/null
    fi
    rm -f /etc/apk/repositories.d/nym-vpn.list 2>/dev/null
fi

exit 0
