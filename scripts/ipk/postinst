#!/bin/sh
# Post-installation script for nym-vpn IPK package

# Create TUN device if needed
[ -e /dev/net/tun ] || {
    mkdir -p /dev/net
    mknod /dev/net/tun c 10 200
    chmod 0666 /dev/net/tun
}

# Register package feed for updates
FEED_BASE="https://packages.dial0ut.org"

# Detect architecture (openwrt_release first, os-release as fallback —
# not all OpenWrt/apk images ship both)
ARCH=""
if [ -f /etc/openwrt_release ]; then
    ARCH=$(. /etc/openwrt_release; echo "$DISTRIB_ARCH")
fi
if [ -z "$ARCH" ] && [ -f /etc/os-release ]; then
    ARCH=$(grep '^OPENWRT_ARCH=' /etc/os-release | cut -d'"' -f2)
fi

if [ -n "$ARCH" ]; then
    if command -v apk >/dev/null 2>&1; then
        # OpenWrt 24.10+ (apk package manager)
        APK_REPO="/etc/apk/repositories.d/nym-vpn.list"
        APK_LINE="${FEED_BASE}/apk/${ARCH}/packages.adb"
        mkdir -p /etc/apk/repositories.d
        # Scrub stale feed lines outside our canonical file. Pre-1.30.1
        # installs wrote a bare directory URL, which makes apk fall back to
        # legacy Alpine resolution (<url>/<arch>/APKINDEX.tar.gz) and 404
        # on every apk operation.
        for f in /etc/apk/repositories /etc/apk/repositories.d/*.list; do
            [ -f "$f" ] || continue
            [ "$f" = "$APK_REPO" ] && continue
            if grep -q "packages\.dial0ut\.org" "$f" 2>/dev/null; then
                grep -v "packages\.dial0ut\.org" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
                echo "Removed stale nym-vpn feed line from $f"
            fi
        done
        # OpenWrt apk expects the repo line to point directly at the
        # packages.adb index (matching its own distfeeds.list, e.g.
        # .../<arch>/base/packages.adb).
        if [ "$(cat "$APK_REPO" 2>/dev/null)" != "$APK_LINE" ]; then
            echo "$APK_LINE" > "$APK_REPO"
            echo "Package feed registered: $APK_LINE"
        fi
    elif [ -f /etc/opkg.conf ]; then
        # OpenWrt <=23.05 (opkg package manager)
        FEED_CONF="/etc/opkg/customfeeds.conf"
        if ! grep -q "nym-vpn" "$FEED_CONF" 2>/dev/null; then
            echo "src/gz nym-vpn ${FEED_BASE}/opkg/${ARCH}" >> "$FEED_CONF"
            echo "Package feed registered: ${FEED_BASE}/opkg/${ARCH}"
        fi
    fi
fi

# Apply backend-aware firewall include registration now. Custom IPK/APK
# packaging does not get OpenWrt's generated postinst wrapper that normally
# executes /etc/uci-defaults, and prerm removes the old section during an
# upgrade. Registering before the daemon starts closes the install-time
# reload gap. On failure the script stays in place for the boot defaults
# runner to retry.
if [ -z "${IPKG_INSTROOT:-}" ] && [ -x /etc/uci-defaults/luci-app-nym-vpn ]; then
    if /etc/uci-defaults/luci-app-nym-vpn; then
        rm -f /etc/uci-defaults/luci-app-nym-vpn
    else
        echo "Firewall include registration failed; will retry at next boot" >&2
    fi
fi

/etc/init.d/nym-vpnd enable
/etc/init.d/nym-vpnd start

# Enable watchdog if always_on was previously set (e.g. upgrade)
if [ "$(uci -q get nym-vpn.settings.always_on)" = "1" ]; then
    /etc/init.d/nym-vpn-watchdog enable
    /etc/init.d/nym-vpn-watchdog start
fi

# Restart rpcd to pick up new ACLs
/etc/init.d/rpcd restart

echo ""
echo "=============================================="
echo "NymVPN installed successfully!"
echo ""
echo "Update with: opkg update && opkg upgrade nym-vpn"
echo "         or: apk update && apk upgrade nym-vpn"
echo "=============================================="

exit 0
