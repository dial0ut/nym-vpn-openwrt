#!/bin/sh
# Post-installation script for nym-vpn IPK package

[ -e /dev/net/tun ] || {
    mkdir -p /dev/net
    mknod /dev/net/tun c 10 200
    chmod 0666 /dev/net/tun
}

FEED_BASE="https://packages.dial0ut.org"

# Not all OpenWrt/apk images ship both release files.
ARCH=""
if [ -f /etc/openwrt_release ]; then
    ARCH=$(. /etc/openwrt_release; echo "$DISTRIB_ARCH")
fi
if [ -z "$ARCH" ] && [ -f /etc/os-release ]; then
    ARCH=$(grep '^OPENWRT_ARCH=' /etc/os-release | cut -d'"' -f2)
fi

if [ -n "$ARCH" ]; then
    if command -v apk >/dev/null 2>&1; then
        APK_REPO="/etc/apk/repositories.d/nym-vpn.list"
        APK_LINE="${FEED_BASE}/apk/${ARCH}/packages.adb"
        mkdir -p /etc/apk/repositories.d
        # A bare directory URL elsewhere makes apk fall back to Alpine-style
        # APKINDEX.tar.gz resolution and 404 on every operation.
        for f in /etc/apk/repositories /etc/apk/repositories.d/*.list; do
            [ -f "$f" ] || continue
            [ "$f" = "$APK_REPO" ] && continue
            if grep -q "packages\.dial0ut\.org" "$f" 2>/dev/null; then
                grep -v "packages\.dial0ut\.org" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
                echo "Removed stale nym-vpn feed line from $f"
            fi
        done
        # OpenWrt apk wants the repo line to point at packages.adb itself.
        if [ "$(cat "$APK_REPO" 2>/dev/null)" != "$APK_LINE" ]; then
            echo "$APK_LINE" > "$APK_REPO"
            echo "Package feed registered: $APK_LINE"
        fi
    elif [ -f /etc/opkg.conf ]; then
        FEED_CONF="/etc/opkg/customfeeds.conf"
        if ! grep -q "nym-vpn" "$FEED_CONF" 2>/dev/null; then
            echo "src/gz nym-vpn ${FEED_BASE}/opkg/${ARCH}" >> "$FEED_CONF"
            echo "Package feed registered: ${FEED_BASE}/opkg/${ARCH}"
        fi
    fi
fi

# Our packaging lacks OpenWrt's generated wrapper that runs /etc/uci-defaults,
# so run it here, before the daemon starts. On failure it stays for the boot
# defaults runner to retry.
if [ -z "${IPKG_INSTROOT:-}" ] && [ -x /etc/uci-defaults/luci-app-nym-vpn ]; then
    if /etc/uci-defaults/luci-app-nym-vpn; then
        rm -f /etc/uci-defaults/luci-app-nym-vpn
    else
        echo "Firewall include registration failed; will retry at next boot" >&2
    fi
fi

/etc/init.d/nym-vpnd enable
# restart, not start: on an upgrade the old daemon is still running and
# procd's start is a no-op. The new init script's restart path keeps the
# kill-switch armed across the swap.
/etc/init.d/nym-vpnd restart

# One-shot migration of the retired shell watchdog (<= 1.34.x): its UCI
# always_on flag becomes the daemon's Always On setting. The old package's
# prerm has already stopped the watchdog; its files are gone but the rc.d
# symlinks, pidfile and state file are not. The uci deletes are no-ops on a
# fresh install. Drop this block two releases on.
if [ -z "${IPKG_INSTROOT:-}" ]; then
    if [ "$(uci -q get nym-vpn.settings.always_on)" = "1" ]; then
        # The setting can only be written once the restarted daemon answers,
        # and this script must not wait on it (see the rpcd note below), so
        # the bounded wait runs detached.
        (
            trap '' HUP
            i=0
            while [ "$i" -lt 30 ] && ! /usr/bin/nym-vpnc tunnel get >/dev/null 2>&1; do
                sleep 1
                i=$((i + 1))
            done
            if /usr/bin/nym-vpnc tunnel set --always-on on >/dev/null 2>&1; then
                logger -t nym-vpn "Always On carried over from the watchdog setting"
            else
                logger -t nym-vpn "could not enable Always On in the daemon; run: nym-vpnc tunnel set --always-on on"
            fi
        ) </dev/null >/dev/null 2>&1 &
        echo "Always On is being carried over to the daemon setting"
    fi
    uci -q delete nym-vpn.settings.always_on
    uci -q delete nym-vpn.settings.watchdog_interval
    uci -q delete nym-vpn.settings.watchdog_max_retries
    uci -q commit nym-vpn
    # rc.common names the stop link K$((100-START)), so K9 here, not K09.
    rm -f /etc/rc.d/*nym-vpn-watchdog
    pid=$(cat /var/run/nym-vpn-watchdog.pid 2>/dev/null)
    if [ -n "$pid" ] && grep -q nym-vpn-watchdog "/proc/$pid/cmdline" 2>/dev/null; then
        kill "$pid" 2>/dev/null
    fi
    rm -f /var/run/nym-vpn-watchdog.pid /var/run/nym-watchdog.state /tmp/nym-watchdog.state

    # Daemons up to 1.34.0_p24 installed masquerade and LAN forwarding for
    # the tunnel into fw3/fw4's own tables; the nym zone now renders them.
    # fw4 reload keeps foreign chains (empty), fw3 reload keeps them whole.
    # Drop this block two releases on.
    for chain in nym_forward_lan nym_postrouting; do
        nft delete chain inet fw4 "$chain" 2>/dev/null
    done
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        for chain in NYM_FORWARD_LAN NYM_POSTROUTING; do
            for table in filter nat mangle; do
                "$ipt" -t "$table" -S 2>/dev/null | grep -- "-j $chain" | sed 's/^-A /-D /' | while read -r rule; do
                    # shellcheck disable=SC2086  # the rule is a word list from iptables -S
                    "$ipt" -t "$table" $rule 2>/dev/null
                done
                "$ipt" -t "$table" -F "$chain" 2>/dev/null && "$ipt" -t "$table" -X "$chain" 2>/dev/null
            done
        done
    done
fi

# rpcd scans /usr/libexec/rpcd only at start-up and computes ACL grants at
# login. The refresh must not run inside this transaction: LuCI's Software
# page drives opkg/apk through rpcd, so restarting it here kills the reply
# the page is waiting on and logs the user out (#13). Upgrades pick the
# refresh from the hashes prerm stashed: nothing if neither the method list
# nor the ACL changed, reload (SIGHUP keeps sessions) for the method list
# alone, restart (forced re-login, which is what applies new grants) for the
# ACL or a missing stash. An empty hash counts as changed.
rm -f /tmp/luci-indexcache* 2>/dev/null
rm -rf /tmp/luci-modulecache/ 2>/dev/null

nym_rpcd_state=/var/run/nym-vpn.rpcd-state
nym_rpcd_action=restart
if [ -f "$nym_rpcd_state" ]; then
    old_plugin=$(sed -n 's/^plugin=//p' "$nym_rpcd_state")
    old_acl=$(sed -n 's/^acl=//p' "$nym_rpcd_state")
    new_plugin=$(out=$(/usr/libexec/rpcd/nym-vpn list 2>/dev/null) && [ -n "$out" ] \
        && printf '%s\n' "$out" | md5sum | cut -d' ' -f1)
    new_acl=$(md5sum /usr/share/rpcd/acl.d/luci-app-nym-vpn.json 2>/dev/null | cut -d' ' -f1)
    if [ -n "$old_acl" ] && [ "$old_acl" = "$new_acl" ]; then
        if [ -n "$old_plugin" ] && [ "$old_plugin" = "$new_plugin" ]; then
            nym_rpcd_action=""
        else
            nym_rpcd_action=reload
        fi
    fi
fi
rm -f "$nym_rpcd_state"
# Image builds have no rpcd and must not leave background processes behind.
[ -z "${IPKG_INSTROOT:-}" ] || nym_rpcd_action=""

# postinst may be a child of the package manager or of a sh wrapper it
# spawned, so walk the parent chain for opkg/apk. NYM_PROC is for tests.
NYM_PROC="${NYM_PROC:-/proc}"
proc_comm() {
    cat "$NYM_PROC/$1/comm" 2>/dev/null
}
proc_ppid() {
    # comm may contain spaces; cut after the last ')'.
    sed 's/.*) //' "$NYM_PROC/$1/stat" 2>/dev/null | cut -d' ' -f2
}
find_package_manager_pid() {
    local pid="$1" depth=0
    while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && [ "$depth" -lt 8 ]; do
        case "$(proc_comm "$pid")" in
            opkg | apk)
                echo "$pid"
                return 0
                ;;
        esac
        pid=$(proc_ppid "$pid")
        depth=$((depth + 1))
    done
    echo "$1"
}

if [ -n "$nym_rpcd_action" ]; then
    nym_pm_pid=$(find_package_manager_pid "$PPID")
    nym_pm_comm=$(proc_comm "$nym_pm_pid")
    # Detached with every fd on /dev/null: opkg waits on this script and apk
    # also reads its stdout/stderr to EOF. Waits for the package manager to
    # exit so rpcd has delivered the transaction's reply first.
    (
        # SSH session may close right after a CLI upgrade.
        trap '' HUP
        # A changed comm means the pid was reused; the bound keeps a wedged
        # transaction from deferring the refresh forever.
        i=0
        while kill -0 "$nym_pm_pid" 2>/dev/null \
            && [ "$(proc_comm "$nym_pm_pid")" = "$nym_pm_comm" ]; do
            if [ "$i" -ge 120 ]; then
                logger -t nym-vpn "package manager pid $nym_pm_pid still running after 120 s; refreshing rpcd anyway"
                break
            fi
            sleep 1
            i=$((i + 1))
        done
        sleep 1
        /etc/init.d/rpcd "$nym_rpcd_action"
        # rpcd builds without a SIGHUP handler exit on reload instead of
        # re-executing.
        sleep 2
        pidof rpcd >/dev/null || /etc/init.d/rpcd start
    ) </dev/null >/dev/null 2>&1 &
fi

echo ""
echo "=============================================="
echo "NymVPN installed successfully!"
if [ "$nym_rpcd_action" = "restart" ]; then
    echo "LuCI will ask you to log in again in a few seconds."
fi
echo ""
echo "Update with: opkg update && opkg upgrade nym-vpn"
echo "         or: apk update && apk upgrade nym-vpn"
echo "=============================================="

exit 0
