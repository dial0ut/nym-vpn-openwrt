# Custom Docker image for ARMv5TE musl cross-compilation
# ARMv5TE is technically Tier 2 in Rust, but needs portable-atomic patches
# for 64-bit atomics (same as 32-bit MIPS targets)
#
# Target devices: Ancient ARM devices, some older OpenWrt routers
# - ARM926EJ-S, ARM946E-S (Nintendo DS era cores)
# - Some legacy embedded Linux devices
#
# See Dockerfile.mips for detailed documentation on the problem and solution

FROM messense/rust-musl-cross:armv5te-musleabi

ARG TARGET=armv5te-unknown-linux-musleabi

# Install latest Rust (nightly required for build-std due to portable-atomic)
RUN rustup self uninstall -y 2>/dev/null || true && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly && \
    . "$HOME/.cargo/env" && \
    rustup component add rust-src

# Install protoc and rsync
RUN apt-get update -qq && apt-get install -y -qq unzip pkg-config curl wget rsync && \
    curl -LO "https://github.com/protocolbuffers/protobuf/releases/download/v30.2/protoc-30.2-linux-x86_64.zip" && \
    unzip -q protoc-30.2-linux-x86_64.zip -d /usr/local && \
    rm protoc-30.2-linux-x86_64.zip

# Fix linker search paths for ARMv5TE musl toolchain
# Problem: Rust passes -nostartfiles then bare crt*.o filenames that linker can't find
# Solution: Use a GCC wrapper that replaces bare filenames with full paths
RUN armv5te-unknown-linux-musleabi-ar rcs /usr/local/musl/armv5te-unknown-linux-musleabi/lib/libunwind.a

# Copy and install the GCC wrapper script
COPY armv5te-gcc-wrapper.sh /usr/local/bin/armv5te-gcc-wrapper
RUN chmod +x /usr/local/bin/armv5te-gcc-wrapper

# Set environment - use wrapper as linker
ENV TARGET=armv5te-unknown-linux-musleabi
ENV CARGO_TARGET_ARMV5TE_UNKNOWN_LINUX_MUSLEABI_LINKER=/usr/local/bin/armv5te-gcc-wrapper
ENV CC_armv5te_unknown_linux_musleabi=armv5te-unknown-linux-musleabi-gcc
ENV AR_armv5te_unknown_linux_musleabi=armv5te-unknown-linux-musleabi-ar

COPY build-tier3.sh /opt/build-tier3.sh
RUN chmod +x /opt/build-tier3.sh

WORKDIR /home/rust/src
