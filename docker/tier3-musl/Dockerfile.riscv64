# Custom Docker image for RISC-V 64-bit musl cross-compilation
# See Dockerfile.mips for detailed documentation on the problem and solution

FROM messense/rust-musl-cross:riscv64gc-musl@sha256:9102e9fa3128e6a817c68fb2b7ef80184bd699b12f0cf2222091b6d7f12e4f8f

ARG TARGET=riscv64gc-unknown-linux-musl

# Install latest Rust (nightly required for build-std)
# Also install llvm-tools for rust-lld (avoids GCC 11.2 linker issues with newer RISC-V extensions)
RUN rustup self uninstall -y 2>/dev/null || true && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly && \
    . "$HOME/.cargo/env" && \
    rustup component add rust-src llvm-tools

# Install rsync, linux-libc-dev for kernel headers, and lld for linking
# Replace ALL instances of the cross-compiler's ld with lld to avoid binutils RISC-V extension issues
# GCC's collect2 uses the ld from its internal toolchain path, not the system ld
RUN apt-get update -qq && apt-get install -y -qq unzip pkg-config curl wget rsync linux-libc-dev lld && \
    find /usr/local/musl -name 'ld' -type f | while read ld_path; do \
        mv "$ld_path" "${ld_path}.bak"; \
        ln -sf /usr/bin/ld.lld "$ld_path"; \
    done

# Install newer protoc (apt version is too old, doesn't support proto3 optional fields)
# protoc 3.12+ supports --experimental_allow_proto3_optional, 3.15+ has it enabled by default
ARG PROTOC_VERSION=30.2
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then PROTOC_ARCH="linux-x86_64"; \
    elif [ "$ARCH" = "aarch64" ]; then PROTOC_ARCH="linux-aarch_64"; \
    else echo "Unsupported arch: $ARCH" && exit 1; fi && \
    curl -fsSL "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-${PROTOC_ARCH}.zip" -o /tmp/protoc.zip && \
    unzip -q /tmp/protoc.zip -d /usr/local && \
    rm /tmp/protoc.zip && \
    protoc --version

# Install Linux kernel headers for RISC-V cross-compilation
# The riscv64gc-musl toolchain is missing linux/ headers, so we need to install them
# Fetched from GitHub's kernel mirror: cdn.kernel.org pruned old point-release
# tarballs and kernel.googlesource.com rate-limits GitHub runner IPs (503).
# Mainline v6.1 UAPI headers are identical to 6.1.x for userspace builds.
ARG KERNEL_TAG=v6.1
RUN cd /tmp && \
    curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors \
      "https://github.com/torvalds/linux/archive/refs/tags/${KERNEL_TAG}.tar.gz" -o linux.tar.gz && \
    tar xzf linux.tar.gz && \
    cd linux-6.1 && \
    make ARCH=riscv INSTALL_HDR_PATH=/usr/local/musl/riscv64-unknown-linux-musl headers_install && \
    cd /tmp && rm -rf linux-6.1 linux.tar.gz

# Create empty libunwind.a stub (satisfies -lunwind when using panic=abort)
RUN riscv64-unknown-linux-musl-ar rcs /usr/local/musl/riscv64-unknown-linux-musl/lib/libunwind.a

# Copy and install the GCC wrapper script (fixes CRT paths for lld)
COPY gcc-wrapper.sh /usr/local/bin/riscv64-gcc-wrapper
RUN chmod +x /usr/local/bin/riscv64-gcc-wrapper

# Set environment
# Note: The Rust target is riscv64gc-unknown-linux-musl but the compiler triplet is riscv64-unknown-linux-musl
# Use the wrapper as linker to fix CRT paths when +crt-static is used
ENV TARGET=riscv64gc-unknown-linux-musl
ENV CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_LINKER=/usr/local/bin/riscv64-gcc-wrapper
ENV GCC_WRAPPER_MUSL_LIB=/usr/local/musl/riscv64-unknown-linux-musl/lib
ENV GCC_WRAPPER_GCC_LIB=/usr/local/musl/lib/gcc/riscv64-unknown-linux-musl/11.2.0
ENV GCC_WRAPPER_CC=riscv64-unknown-linux-musl-gcc
ENV CC_riscv64gc_unknown_linux_musl=riscv64-unknown-linux-musl-gcc
ENV AR_riscv64gc_unknown_linux_musl=riscv64-unknown-linux-musl-ar

COPY build-tier3-dynamic.sh /opt/build-tier3-dynamic.sh
RUN chmod +x /opt/build-tier3-dynamic.sh

WORKDIR /home/rust/src
