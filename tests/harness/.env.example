# Copy this to .env in the same directory and fill in real values.
# .env is gitignored. NEVER commit it.

# Account mnemonic, 24 words. Used by `nym-vpnc account set`.
NYM_MNEMONIC=""

# SSH alias for the Proxmox host that hosts the test containers.
PROXMOX_HOST="proxmox"

# Packages under test. The slot runner picks the format by OpenWrt version:
# 25.x and later install the .apk, older releases the .ipk. Without these the
# slots install from the public feed, which is NOT the revision under test.
# NYM_PKG_APK=/path/to/nym-vpn_1.35.0_x86_64.apk
# NYM_PKG_IPK=/path/to/nym-vpn_1.35.0_x86_64.ipk
#
# Previous release of each format. When set, the slot installs it first and
# cases/10-upgrade.sh upgrades to the package above while sampling the
# kill-switch every second (the table must never disappear). Without it that
# case is a SKIP.
# NYM_PKG_APK_PREV=/path/to/nym-vpn_1.34.0_x86_64.apk
# NYM_PKG_IPK_PREV=/path/to/nym-vpn_1.34.0_x86_64.ipk
#
# One file for every slot, overriding the per-format variables.
# NYM_PKG_FILE=/path/to/nym-vpn_1.35.0_x86_64.apk
#
# Or point the feed install at another feed's install script.
# NYM_FEED_INSTALL_URL=https://packages.dial0ut.org/install.sh

# Override only if you want non-default placement.
# Default starts at 510 (slot 1) / 520 (slot 2) / 530 (slot 3).
# CTID_BASE=510
