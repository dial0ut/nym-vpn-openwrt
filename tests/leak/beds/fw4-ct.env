# shellcheck shell=bash
# Bed: OpenWrt 25.x with fw4/nftables as a Proxmox LXC, an Alpine LXC as the
# LAN client behind it, the WAN captured on the Proxmox host at the CT's veth.
#
# Sourced by run.sh (BED=fw4-ct). Every value here is a default: set the
# same variable in the environment to override it without editing the file.
# The router is controlled with pct exec from the hypervisor, so the control
# path does not depend on the router's WAN link; the ssh target is used only
# for the management-access checks (a session held open across the failure).

: "${LEAK_FW:=fw4}"                       # firewall backend: fw3 | fw4
: "${LEAK_PROXMOX:=proxmox}"              # ssh alias of the hypervisor (capture point)
: "${LEAK_VMID:=}"                        # router VM id; empty on an LXC bed
: "${LEAK_ROUTER_CT:=425}"                # router LXC id for pct exec control
: "${LEAK_ROUTER_HOST:=root@192.168.1.252}"  # ssh target of the router (management access)
: "${LEAK_ROUTER_SSH_OPTS:=}"
: "${LEAK_SSH_JUMP:=}"                    # ProxyJump host for the router ssh, if the dev machine's path is poor
: "${LEAK_ROUTER_WAN_IP:=192.168.1.252}"  # router WAN address as seen in the capture
: "${LEAK_ROUTER_WAN_DEV:=eth0}"          # router-side WAN interface name
: "${LEAK_ROUTER_LAN_IP:=10.10.10.1}"     # router LAN address (LAN client's gateway and resolver)
: "${LEAK_UPSTREAM_DNS:=192.168.1.1}"     # resolver the router would forward to when open
: "${LEAK_WAN_IF:=veth425i0}"             # host interface carrying the router's WAN (tcpdump)
: "${LEAK_LAN_CT:=903}"                   # LAN client LXC on the router's LAN bridge (pct exec)
: "${LEAK_LAN_SSH:=}"                     # or an ssh command line to the LAN client (word-split)
# The address the LAN client would show when it leaves the box outside the
# tunnel. Empty = learned at bed_up from the hypervisor, which shares the
# router's upstream NAT. Set it to a documented placeholder such as
# 203.0.113.1 to disable that lookup.
: "${LEAK_REAL_PUBLIC_IP:=}"
: "${LEAK_UPGRADE_APK:=/tmp/nym-vpn_1.34.0_p14_x86_64.apk}"  # for 18-upgrade-interrupted-apk
