# shellcheck shell=bash
# Bed: OpenWrt 21.02 with fw3/iptables as a Proxmox VM, an Alpine LXC as the
# LAN client behind it, the WAN captured on the Proxmox host at the VM's tap.
#
# Sourced by run.sh (BED=fw3-vm). Every value here is a default: set the
# same variable in the environment to override it without editing the file.
# The router is controlled over ssh to its WAN address (a VM has no pct exec),
# so the router-side checks are unavailable while the WAN link is down.

: "${LEAK_FW:=fw3}"                       # firewall backend: fw3 | fw4
: "${LEAK_PROXMOX:=proxmox}"              # ssh alias of the hypervisor (capture point)
: "${LEAK_VMID:=902}"                     # router VM (qm start/stop)
: "${LEAK_ROUTER_CT:=}"                   # router LXC id for pct exec control; empty = ssh only
: "${LEAK_ROUTER_HOST:=root@192.168.1.180}"  # ssh target of the router (management access)
: "${LEAK_ROUTER_SSH_OPTS:=-i $HOME/.ssh/id_ed25519}"
: "${LEAK_SSH_JUMP:=}"                    # ProxyJump host for the router ssh, if the dev machine's path is poor
: "${LEAK_ROUTER_WAN_IP:=192.168.1.180}"  # router WAN address as seen in the capture
: "${LEAK_ROUTER_WAN_DEV:=eth1}"          # router-side WAN interface name
: "${LEAK_ROUTER_LAN_IP:=10.30.30.1}"     # router LAN address (LAN client's gateway and resolver)
: "${LEAK_UPSTREAM_DNS:=192.168.1.1}"     # resolver the router would forward to when open
: "${LEAK_WAN_IF:=tap902i1}"              # host interface carrying the router's WAN (tcpdump)
: "${LEAK_LAN_CT:=903}"                   # LAN client LXC on the router's LAN bridge (pct exec)
: "${LEAK_LAN_SSH:=}"                     # or an ssh command line to the LAN client (word-split)
# The address the LAN client would show when it leaves the box outside the
# tunnel. Empty = learned at bed_up from the hypervisor, which shares the
# router's upstream NAT. Set it to a documented placeholder such as
# 203.0.113.1 to disable that lookup.
: "${LEAK_REAL_PUBLIC_IP:=}"
: "${LEAK_UPGRADE_IPK:=/tmp/nym-vpn_1.34.0_p15_x86_64.ipk}"  # for 08-interrupted-upgrade
