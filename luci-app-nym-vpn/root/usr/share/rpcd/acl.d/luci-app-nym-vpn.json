{
  "luci-app-nym-vpn": {
    "description": "Grant access to Nym VPN configuration",
    "read": {
      "ubus": {
        "nym-vpn": [
          "init",
          "status",
          "info",
          "gateway_get",
          "gateway_list_full",
          "gateway_list_countries",
          "gateway_list_by_country",
          "tunnel_get",
          "account_get",
          "network_get",
          "lan_get",
          "inbound_list",
          "split_list",
          "split_status",
          "clients_list",
          "ad_block_get",
          "stats_get",
          "dns_get",
          "daemon_status",
          "watchdog_get",
          "logs_get",
          "diagnostic_run"
        ],
        "service": [
          "list"
        ]
      },
      "uci": [
        "nym-vpn"
      ]
    },
    "write": {
      "ubus": {
        "nym-vpn": [
          "connect",
          "disconnect",
          "gateway_set",
          "tunnel_set",
          "account_set",
          "account_forget",
          "account_reset",
          "account_rotate_keys",
          "network_set",
          "lan_set",
          "inbound_add",
          "inbound_del",
          "split_add",
          "split_del",
          "split_set_enabled",
          "ad_block_set",
          "stats_set",
          "dns_set",
          "daemon_restart",
          "daemon_start",
          "daemon_stop",
          "watchdog_set"
        ],
        "service": [
          "start",
          "stop",
          "restart",
          "reload"
        ]
      },
      "uci": [
        "nym-vpn",
        "dhcp"
      ]
    }
  }
}
