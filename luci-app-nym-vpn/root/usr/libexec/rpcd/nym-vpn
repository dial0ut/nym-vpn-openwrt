handle_init() {
    # Batch all fast local nym-vpnc calls into a single RPC response.
    # This replaces 8 separate rpcd→shell→nym-vpnc invocations with 1.
    local status_raw=$($VPNC status 2>&1)
    local info_raw=$($VPNC info 2>&1)
    local gateway_raw=$($VPNC gateway get 2>&1)
    local tunnel_raw=$($VPNC tunnel get 2>&1)
    local account_raw=$($VPNC account get 2>&1)
    local network_raw=$($VPNC network get 2>&1)
    local lan_raw=$($VPNC lan get 2>&1)
    local inbound_raw=$($VPNC inbound list 2>&1)
    local adblock_raw=$($VPNC ad-block get 2>&1)
    local dns_raw=$($VPNC dns get 2>&1)
    local daemon_status=$(/etc/init.d/nym-vpnd status 2>&1)

    json_init

    # Status
    json_add_object "status"
    if echo "$status_raw" | grep -q "State: Connected"; then
        json_add_string "state" "connected"
        json_add_boolean "connected" 1

        if echo "$status_raw" | grep -q "Connected mix"; then
            json_add_string "mode" "mixnet"
            local entry_part=$(echo "$status_raw" | sed -n 's/.*Connected mix to \([^→]*\)→.*/\1/p')
            local exit_part=$(echo "$status_raw" | sed -n 's/.*→ \(.*\)/\1/p')
            local entry_ip=$(echo "$entry_part" | sed -n 's/\([0-9.]*\).*/\1/p')
            local entry_id=$(echo "$entry_part" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')
            local exit_ip=$(echo "$exit_part" | sed -n 's/\([0-9.]*\).*/\1/p')
            local exit_id=$(echo "$exit_part" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')
        elif echo "$status_raw" | grep -q "Connected wg"; then
            json_add_string "mode" "wireguard"
            local entry_part=$(echo "$status_raw" | sed -n 's/.*Connected wg to \([^→]*\)→.*/\1/p')
            local exit_part=$(echo "$status_raw" | sed -n 's/.*→ \(.*\)/\1/p')
            local entry_ip=$(echo "$entry_part" | sed -n 's/\([0-9.]*\):.*/\1/p')
            local entry_id=$(echo "$entry_part" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')
            local exit_ip=$(echo "$exit_part" | sed -n 's/\([0-9.]*\):.*/\1/p')
            local exit_id=$(echo "$exit_part" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')
        fi
        [ -n "$entry_ip" ] && json_add_string "entry_ip" "$entry_ip"
        [ -n "$entry_id" ] && json_add_string "entry_id" "$entry_id"
        [ -n "$exit_ip" ] && json_add_string "exit_ip" "$exit_ip"
        [ -n "$exit_id" ] && json_add_string "exit_id" "$exit_id"
    elif echo "$status_raw" | grep -q "State: Connecting"; then
        json_add_string "state" "connecting"
        json_add_boolean "connected" 0
        emit_account_error "$account_raw"
    elif echo "$status_raw" | grep -q "State: Disconnecting"; then
        json_add_string "state" "disconnecting"
        json_add_boolean "connected" 0
        emit_account_error "$account_raw"
    elif echo "$status_raw" | grep -q "State: Disconnected"; then
        json_add_string "state" "disconnected"
        json_add_boolean "connected" 0
        emit_account_error "$account_raw"
    elif echo "$status_raw" | grep -q "State: Error"; then
        json_add_string "state" "disconnected"
        json_add_boolean "connected" 0
        json_add_string "raw_state" "$status_raw"
        emit_account_error "$account_raw"
    else
        json_add_string "state" "unknown"
        json_add_boolean "connected" 0
        emit_account_error "$account_raw"
    fi
    json_close_object

    # Info
    json_add_object "info"
    local version=$(echo "$info_raw" | grep "version:" | head -1 | sed 's/.*version: //')
    local info_network=$(echo "$info_raw" | grep "network_name:" | sed 's/.*network_name: //')
    [ -n "$version" ] && json_add_string "version" "$version"
    [ -n "$info_network" ] && json_add_string "network" "$info_network"
    json_close_object

    # Gateway config
    json_add_object "gateway_config"
    local gw_entry=$(echo "$gateway_raw" | grep "Entry point:" | sed 's/Entry point: //')
    local gw_exit=$(echo "$gateway_raw" | grep "Exit point:" | sed 's/Exit point: //')
    local gw_residential=$(echo "$gateway_raw" | grep "Residential exit:" | sed 's/Residential exit: //')
    json_add_string "entry_point" "$(format_point "$gw_entry")"
    json_add_string "exit_point" "$(format_point "$gw_exit")"
    json_add_string "residential_exit" "$gw_residential"
    json_close_object

    # Tunnel config
    json_add_object "tunnel_config"
    local t_ipv6=$(echo "$tunnel_raw" | grep "IPv6:" | sed 's/.*IPv6: //')
    local t_two_hop=$(echo "$tunnel_raw" | grep "Two-hop:" | sed 's/.*Two-hop: //')
    local t_netstack=$(echo "$tunnel_raw" | grep "Netstack:" | sed 's/.*Netstack: //')
    local t_circumvention=$(echo "$tunnel_raw" | grep "Circumvention transports:" | sed 's/.*Circumvention transports: //')
    local t_killswitch=$(echo "$tunnel_raw" | grep "Kill-switch:" | sed 's/.*Kill-switch: //')
    json_add_string "ipv6" "$t_ipv6"
    json_add_string "two_hop" "$t_two_hop"
    json_add_string "netstack" "$t_netstack"
    json_add_string "circumvention_transports" "$t_circumvention"
    json_add_string "killswitch" "$t_killswitch"
    json_close_object

    # Account
    json_add_object "account"
    local a_identity=$(echo "$account_raw" | grep "Account identity:" | sed 's/Account identity: //')
    local a_state=$(echo "$account_raw" | grep "Account state:" | sed 's/Account state: //')
    json_add_string "identity" "$a_identity"
    json_add_string "state" "$a_state"
    json_close_object

    # Network
    json_add_object "network"
    local net_name=$(echo "$network_raw" | sed 's/Current network: //')
    json_add_string "network" "$net_name"
    json_close_object

    # LAN
    json_add_object "lan"
    json_add_string "policy" "$lan_raw"
    json_close_object

    # Inbound exemptions — see note in handle_inbound_list re: subshell.
    json_add_array "inbound_exemptions"
    if ! echo "$inbound_raw" | grep -q "^No inbound"; then
        while IFS= read -r line; do
            local proto=$(echo "$line" | sed -n 's|^\([a-z]\+\)/[0-9]\+.*|\1|p')
            local dport=$(echo "$line" | sed -n 's|^[a-z]\+/\([0-9]\+\).*|\1|p')
            [ -z "$proto" ] && continue
            [ -z "$dport" ] && continue
            local label=$(echo "$line" | sed -n 's|^[a-z]\+/[0-9]\+ — \(.*\)$|\1|p')
            json_add_object ""
            json_add_string "proto" "$proto"
            json_add_int "dport" "$dport"
            [ -n "$label" ] && json_add_string "label" "$label"
            json_close_object
        done <<EOF
$inbound_raw
EOF
    fi
    json_close_array

    # Ad-block
    json_add_object "ad_block"
    if echo "$adblock_raw" | grep -qi "enabled"; then
        json_add_boolean "enabled" 1
    else
        json_add_boolean "enabled" 0
    fi
    json_close_object

    # Custom DNS
    json_add_object "dns"
    if echo "$dns_raw" | grep -q "Enabled"; then
        json_add_boolean "enabled" 1
    else
        json_add_boolean "enabled" 0
    fi
    local dns_servers=$(echo "$dns_raw" | sed -n 's/.*\[\(.*\)\].*/\1/p')
    json_add_string "servers" "$dns_servers"
    json_close_object

    # Daemon status
    json_add_object "daemon"
    if [ "$daemon_status" = "running" ]; then
        json_add_string "status" "running"
        json_add_boolean "running" 1
    else
        json_add_string "status" "stopped"
        json_add_boolean "running" 0
    fi
    json_close_object

    # Watchdog / Always-on
    json_add_object "watchdog"
    local wd_always_on=$(uci -q get nym-vpn.settings.always_on 2>/dev/null)
    local wd_interval=$(uci -q get nym-vpn.settings.watchdog_interval 2>/dev/null)
    json_add_boolean "always_on" "${wd_always_on:-0}"
    json_add_int "interval" "${wd_interval:-30}"
    local wd_service=$(/etc/init.d/nym-vpn-watchdog status 2>&1)
    if [ "$wd_service" = "running" ]; then
        json_add_string "service" "running"
    else
        json_add_string "service" "stopped"
    fi
    if [ -f /tmp/nym-watchdog.state ]; then
        . /tmp/nym-watchdog.state
        json_add_string "state" "${state:-unknown}"
        json_add_int "failures" "${failures:-0}"
    else
        json_add_string "state" "inactive"
        json_add_int "failures" 0
    fi
    json_close_object

    json_dump
}

handle_watchdog_get() {
    json_init

    local always_on=$(uci -q get nym-vpn.settings.always_on 2>/dev/null)
    local interval=$(uci -q get nym-vpn.settings.watchdog_interval 2>/dev/null)
    local max_retries=$(uci -q get nym-vpn.settings.watchdog_max_retries 2>/dev/null)
    local service_status=$(/etc/init.d/nym-vpn-watchdog status 2>&1)

    json_add_boolean "always_on" "${always_on:-0}"
    json_add_int "interval" "${interval:-30}"
    json_add_int "max_retries" "${max_retries:-3}"

    if [ "$service_status" = "running" ]; then
        json_add_string "service" "running"
    else
        json_add_string "service" "stopped"
    fi

    # Read watchdog state file if present
    if [ -f /tmp/nym-watchdog.state ]; then
        . /tmp/nym-watchdog.state
        json_add_string "state" "${state:-unknown}"
        json_add_int "failures" "${failures:-0}"
        json_add_string "last_action" "${last_action:-none}"
        json_add_int "timestamp" "${timestamp:-0}"
    else
        json_add_string "state" "inactive"
        json_add_int "failures" 0
        json_add_string "last_action" "none"
        json_add_int "timestamp" 0
    fi

    json_dump
}

handle_watchdog_set() {
    read -r input
    json_load "$input"

    local always_on interval
    json_get_var always_on "always_on"
    json_get_var interval "interval"

    json_init

    # Validate always_on
    case "$always_on" in
        0|1) ;;
        *)
            json_add_boolean "success" 0
            json_add_string "error" "Invalid value (must be 0 or 1)"
            json_dump
            return
            ;;
    esac

    # Validate interval if provided
    if [ -n "$interval" ]; then
        case "$interval" in
            1|5|15|30|60|120) ;;
            *)
                json_add_boolean "success" 0
                json_add_string "error" "Invalid interval (must be 1, 5, 15, 30, 60, or 120)"
                json_dump
                return
                ;;
        esac
        uci set nym-vpn.settings.watchdog_interval="$interval"
    fi

    uci set nym-vpn.settings.always_on="$always_on"
    uci commit nym-vpn

    if [ "$always_on" = "1" ]; then
        /etc/init.d/nym-vpn-watchdog enable 2>/dev/null
        /etc/init.d/nym-vpn-watchdog start 2>/dev/null
    else
        /etc/init.d/nym-vpn-watchdog stop 2>/dev/null
        /etc/init.d/nym-vpn-watchdog disable 2>/dev/null
        rm -f /tmp/nym-watchdog.state
    fi

    json_add_boolean "success" 1
    json_add_string "message" "Always-on $([ "$always_on" = "1" ] && echo "enabled" || echo "disabled")"
    json_dump
}

handle_logs_get() {
    read input
    json_load "$input"

    local lines
    json_get_var lines lines

    case "$lines" in
        ''|*[!0-9]*) lines=200 ;;
    esac
    [ "$lines" -lt 10 ]   && lines=10
    [ "$lines" -gt 2000 ] && lines=2000

    # logread's `-l N` clips the scan window, not the filtered output, so
    # `-l N -e pat` can return fewer than N matches when noise is high.
    # Filter the full buffer with `-e`, then take the last N filtered lines.
    # Also strip ANSI color escapes emitted by the tracing crate — LuCI's
    # RPC pipeline doesn't preserve raw 0x1b control bytes cleanly.
    local esc
    esc=$(printf '\033')
    local output
    output=$(logread -e nym-vpn 2>/dev/null | tail -n "$lines" | sed "s/${esc}\[[0-9;]*m//g")

    json_init
    json_add_boolean "success" 1
    json_add_string "logs" "$output"
    json_add_int "lines" "$lines"
    json_dump
}

handle_diagnostic_run() {
    read input
    json_load "$input"

    local skip_dns skip_http gateway
    json_get_var skip_dns skip_dns
    json_get_var skip_http skip_http
    json_get_var gateway gateway

    # The diagnostic probes DNS, the VPN API over HTTP, and the selected
    # gateway's TCP/WebSocket reachability. nym-vpnc prints a JSON report on
    # success; we pass it through verbatim for the LuCI view to parse.
    set -- run
    [ "$skip_dns" = "1" -o "$skip_dns" = "true" ]   && set -- "$@" --skip-dns
    [ "$skip_http" = "1" -o "$skip_http" = "true" ] && set -- "$@" --skip-http
    if [ -n "$gateway" ]; then
        gateway=$(validate_input "$gateway" gateway_id)
        [ -n "$gateway" ] && set -- "$@" --gateway "$gateway"
    fi

    local report
    report=$($VPNC diagnostic "$@" 2>&1)
    local rc=$?

    json_init
    if [ "$rc" -ne 0 ] || [ -z "$report" ]; then
        json_add_boolean "success" 0
        json_add_string "error" "${report:-diagnostic failed}"
    else
        json_add_boolean "success" 1
        json_add_string "report" "$report"
    fi
    json_dump
}

handle_daemon_status() {
    json_init

    local status=$(/etc/init.d/nym-vpnd status 2>&1)

    if [ "$status" = "running" ]; then
        json_add_string "status" "running"
        json_add_boolean "running" 1
    else
        json_add_string "status" "stopped"
        json_add_boolean "running" 0
    fi

    json_dump
}

handle_daemon_restart() {
    json_init

    # An in-place `restart` re-launches the daemon too quickly: it can come
    # back before the previous instance has released its socket/state, which
    # leaves the account controller wedged (the 1.27.1 reports where "restart
    # does not work" but stop → wait → start does). Sequence it explicitly with
    # a gap so the old instance fully tears down first.
    /etc/init.d/nym-vpnd stop >/dev/null 2>&1
    sleep 3
    /etc/init.d/nym-vpnd start >/dev/null 2>&1
    sleep 3

    local status=$(/etc/init.d/nym-vpnd status 2>&1)

    if [ "$status" = "running" ]; then
        json_add_boolean "success" 1
        json_add_string "message" "Daemon restarted successfully"
        json_add_string "status" "running"
    else
        json_add_boolean "success" 0
        json_add_string "error" "Daemon failed to start"
        json_add_string "status" "stopped"
    fi

    json_dump
}

handle_daemon_start() {
    json_init

    /etc/init.d/nym-vpnd start >/dev/null 2>&1
    sleep 2

    local status=$(/etc/init.d/nym-vpnd status 2>&1)

    if [ "$status" = "running" ]; then
        json_add_boolean "success" 1
        json_add_string "message" "Daemon started"
        json_add_string "status" "running"
    else
        json_add_boolean "success" 0
        json_add_string "error" "Daemon failed to start"
        json_add_string "status" "stopped"
    fi

    json_dump
}

handle_daemon_stop() {
    json_init

    /etc/init.d/nym-vpnd stop >/dev/null 2>&1
    sleep 1

    local status=$(/etc/init.d/nym-vpnd status 2>&1)

    if [ "$status" = "running" ]; then
        json_add_boolean "success" 0
        json_add_string "error" "Daemon failed to stop"
        json_add_string "status" "running"
    else
        json_add_boolean "success" 1
        json_add_string "message" "Daemon stopped"
        json_add_string "status" "stopped"
    fi

    json_dump
}

