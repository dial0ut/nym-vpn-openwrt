# Hard recovery for the account-state desync where `nym-vpnc account forget`
# can't clear a stranded account: forget requires the tunnel to be in
# Disconnected, and an account error (e.g. Device Time Desynced) strands it in
# Error/Disconnecting, so the command is rejected and the stored mnemonic is
# never removed — `account get` keeps reporting the account as set. This
# mirrors the proven manual fix (stop daemon, wipe the account/key store under
# the data dir, start again with a delay), bypassing the forget precondition.
# Only the daemon data dir (/etc/nym/data: mnemonic, device keys, credentials
# and wireguard-keys DBs, mixnet identity) is wiped; UCI settings in
# /etc/config/nym-vpn and the global config in /etc/nym are left untouched.
handle_account_reset() {
    json_init

    /etc/init.d/nym-vpnd stop >/dev/null 2>&1
    # Give procd time to tear down the tunnel and release the data dir before
    # we delete it — a plain `restart` is too quick and leaves stale state.
    sleep 3

    # Belt-and-braces: kill any lingering process holding the data dir open.
    killall nym-vpnd >/dev/null 2>&1
    sleep 1

    rm -rf /etc/nym/data >/dev/null 2>&1
    mkdir -p /etc/nym/data

    /etc/init.d/nym-vpnd start >/dev/null 2>&1
    # The daemon needs a moment to come up and re-create its stores before the
    # UI polls account state again.
    sleep 3

    local status=$(/etc/init.d/nym-vpnd status 2>&1)
    if [ "$status" = "running" ]; then
        json_add_boolean "success" 1
        json_add_string "message" "Account state reset; daemon restarted"
        json_add_string "status" "running"
    else
        json_add_boolean "success" 0
        json_add_string "error" "Account store wiped but daemon failed to restart"
        json_add_string "status" "stopped"
    fi
    json_dump
}

