handle_inbound_list() {
    # Output format from `nym-vpnc inbound list`:
    #   No inbound exemptions configured.
    # OR one per line:
    #   tcp/443 — HTTPS reverse proxy
    #   udp/51820
    local output=$($VPNC inbound list 2>&1)

    json_init
    json_add_array "exemptions"

    if ! echo "$output" | grep -q "^No inbound"; then
        # NOTE: heredoc keeps the while loop in the same shell as json_*
        # functions so they mutate the parent's JSON state. Using
        # `echo "$output" | while` would run the loop in a subshell and
        # silently drop every json_add_object call.
        while IFS= read -r line; do
            local proto=$(echo "$line" | sed -n 's|^\([a-z]\+\)/[0-9]\+.*|\1|p')
            local dport=$(echo "$line" | sed -n 's|^[a-z]\+/\([0-9]\+\).*|\1|p')
            [ -z "$proto" ] && continue
            [ -z "$dport" ] && continue
            local label=$(echo "$line" | sed -n 's|^[a-z]\+/[0-9]\+ — \(.*\)$|\1|p')
            json_add_object ""
            json_add_string "proto" "$proto"
            json_add_int "dport" "$dport"
            [ -n "$label" ] && json_add_string "label" "$label"
            json_close_object
        done <<EOF
$output
EOF
    fi

    json_close_array
    json_dump
}

