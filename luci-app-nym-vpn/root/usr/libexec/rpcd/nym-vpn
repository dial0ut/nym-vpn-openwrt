handle_dns_set() {
    read input
    json_load "$input"
    json_get_var enabled enabled
    json_get_var servers servers

    # Handle enable/disable
    if [ "$enabled" = "1" -o "$enabled" = "true" ]; then
        $VPNC dns enable >/dev/null 2>&1
    elif [ "$enabled" = "0" -o "$enabled" = "false" ]; then
        $VPNC dns disable >/dev/null 2>&1
    fi

    # Handle server list if provided
    if [ -n "$servers" ]; then
        # Validate each server is an IP address
        local valid_servers=""
        for s in $servers; do
            if echo "$s" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || echo "$s" | grep -qE '^[0-9a-fA-F:]+$'; then
                valid_servers="$valid_servers $s"
            fi
        done
        valid_servers=$(echo "$valid_servers" | sed 's/^[[:space:]]*//')
        if [ -n "$valid_servers" ]; then
            $VPNC dns set $valid_servers >/dev/null 2>&1
        fi
    elif [ "$servers" = "" ] && [ -n "$enabled" ]; then
        # servers explicitly empty — clear them
        $VPNC dns clear >/dev/null 2>&1
    fi

    json_init
    json_add_boolean "success" 1
    json_add_string "message" "DNS configuration updated"
    json_dump
}

