# Enable nym-vpnd service on install
/etc/init.d/nym-vpnd enable 2>/dev/null

# Register the include for the ACTIVE firewall backend, as decided by the
# shared detector (live state, then the firewall init script, then binary
# presence — the boot-time defaults runner executes before the firewall
# service, so this must still resolve correctly with nothing loaded).
if [ -x /usr/share/nym-vpn/fw-backend.sh ]; then
    nym_fw_backend="$(/usr/share/nym-vpn/fw-backend.sh)"
elif grep -q -w fw4 /etc/init.d/firewall 2>/dev/null || [ -x /sbin/fw4 ]; then
    nym_fw_backend="fw4"
else
    nym_fw_backend="fw3"
fi
if [ "$nym_fw_backend" = "fw4" ]; then
    nym_fw_include="/usr/share/nym-vpn/fw4-include.sh"
    nym_fw_reload=""
else
    nym_fw_include="/usr/share/nym-vpn/fw3-include.sh"
    nym_fw_reload="1"
fi

# Reconcile every field, not just the path. This repairs disabled or legacy
# sections left by earlier packages and removes fw4_compatible, which would
# make fw4 capture stdout instead of running the include's nft side effects.
uci set firewall.nym_vpn=include
uci set firewall.nym_vpn.type=script
uci set firewall.nym_vpn.path="$nym_fw_include"
uci set firewall.nym_vpn.enabled=1
uci -q delete firewall.nym_vpn.fw4_compatible
if [ -n "$nym_fw_reload" ]; then
    uci set firewall.nym_vpn.reload="$nym_fw_reload"
else
    uci -q delete firewall.nym_vpn.reload
fi
uci commit firewall

# rpcd and the LuCI caches are deliberately left alone here: the package
# postinst owns that and defers the rpcd refresh until the package
# transaction has returned. This script runs inside that transaction, and
# restarting rpcd there breaks installs driven from LuCI's Software page,
# which runs opkg/apk through rpcd (#13). At first boot rpcd has not
# started yet, so there is nothing to refresh.

exit 0
