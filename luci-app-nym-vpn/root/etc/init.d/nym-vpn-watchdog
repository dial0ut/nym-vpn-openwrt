#!/bin/sh /etc/rc.common
START=91
STOP=9
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/nym-vpn-watchdog
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/nym-vpn-watchdog.pid
    procd_close_instance
}
