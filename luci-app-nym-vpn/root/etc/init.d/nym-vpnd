#!/bin/sh /etc/rc.common
START=90
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="reset_account"
EXTRA_HELP="	reset_account	Stop, wipe the account and key store, start (kill-switch kept)"

# fw-boot-guard.sh owns the runtime-directory paths and checks and the
# fw3/fw4 detection. It ships in the package; without it this script cannot
# stop the daemon safely, so it refuses to do anything.
NYM_SHARE_DIR="${NYM_SHARE_DIR:-/usr/share/nym-vpn}"
[ -r "$NYM_SHARE_DIR/fw-boot-guard.sh" ] || {
    logger -t nym-vpnd -p daemon.err "$NYM_SHARE_DIR/fw-boot-guard.sh is missing; reinstall nym-vpn"
    exit 1
}
# shellcheck source=/dev/null
. "$NYM_SHARE_DIR/fw-boot-guard.sh"

# Written on explicit stop, cleared on start: while present, a firewall
# reload must not re-install the boot block. tmpfs, so a reboot re-arms it.
STOPPED_MARKER="$NYM_VPND_STOPPED"

# Only an explicit `stop` opens the network. `restart` (also how a package
# upgrade swaps the daemon), `shutdown` (the K-script on reboot) and
# `reset_account` keep the kill-switch armed: rc.common leaves $action set
# in the stop hooks, and an open firewall in the last seconds of a reboot
# leaked LAN DNS/HTTPS on WAN.
keep_killswitch() {
    # shellcheck disable=SC2154  # action is set by rc.common
    case "$action" in
        restart|shutdown|reset_account) return 0 ;;
    esac
    return 1
}

# The rpcd bridge's account hard-reset. Runs as an EXTRA_COMMAND, so the
# stop hooks see $action=reset_account and keep the kill-switch.
reset_account() {
    stop
    rm -rf /etc/nym/data
    mkdir -p /etc/nym/data
    start
}

start_service() {
    rm -f "$STOPPED_MARKER"

    # fw4 integration needs its table; the reload also runs the include,
    # which arms the boot block until the daemon's first policy.
    if [ -x /etc/init.d/firewall ] && ! nft list table inet fw4 >/dev/null 2>&1; then
        /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
    mkdir -p /etc/nym/data
    procd_open_instance
    procd_set_param command /usr/sbin/nym-vpnd
    # retry=0: respawn forever. If procd gave up, the kill-switch table
    # would outlive the daemon with nothing left to clear it.
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/nym-vpnd.pid
    procd_close_instance
}

STOP_PID_STASH="$NYM_RUNTIME_DIR/stop-pid"

stop_service() {
    # First, before anything can block: a racing reload must see the marker.
    if ! keep_killswitch; then
        if nym_runtime_dir_prepare; then
            touch "$STOPPED_MARKER" 2>/dev/null
        else
            logger -t nym-vpn "not writing $STOPPED_MARKER: $NYM_RUNTIME_DIR is not a private root-owned directory"
        fi
    fi

    # service_stopped() needs the pid; pidof would match rc.common itself
    # (comm "nym-vpnd").
    if nym_runtime_dir_prepare; then
        cat /var/run/nym-vpnd.pid 2>/dev/null > "$STOP_PID_STASH"
    fi

    # A hung daemon accepts the socket but never replies; BusyBox has no
    # timeout(1), so bound the disconnect by hand.
    /usr/bin/nym-vpnc disconnect 2>/dev/null &
    local vpnc=$! i=0
    while kill -0 "$vpnc" 2>/dev/null && [ "$i" -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    kill -9 "$vpnc" 2>/dev/null
    return 0
}

service_stopped() {
    # The kill-switch table outlives the process; on explicit stop this is
    # what opens the router. procd's kill is asynchronous and the daemon
    # re-asserts Blocked on the way out, so wait for the pid to really exit
    # (SIGKILL lands after term_timeout 5s). The cmdline check guards
    # against pid reuse.
    local pid i=0
    pid="$(cat "$STOP_PID_STASH" 2>/dev/null)"
    rm -f "$STOP_PID_STASH"
    while [ -n "$pid" ] && grep -q nym-vpnd "/proc/$pid/cmdline" 2>/dev/null \
        && [ "$i" -lt 20 ]; do
        sleep 1
        i=$((i + 1))
    done

    # The daemon left its policy in place; the next daemon's first apply
    # replaces it. If it never comes up, `stop` is what opens the router.
    if keep_killswitch; then
        logger -t nym-vpn "nym-vpnd $action: leaving the kill-switch armed"
        return 0
    fi

    nft delete table inet nym 2>/dev/null || true
    nft delete table inet nym_boot 2>/dev/null || true

    # fw3: the include owns the chain teardown (stop marker present: discard
    # persisted state, remove chains and jumps), the same path a reload
    # takes, run under the shared state lock with NYM_FW_LOCKED=1 so the
    # include does not re-take it (deadlock).
    (
        # No lock, no fw3 mutation; the include honours the marker on its
        # next run and finishes the teardown there.
        if ! command -v flock >/dev/null 2>&1 || ! nym_runtime_dir_prepare; then
            logger -t nym-vpn "cannot take the fw3 state lock; the next firewall reload performs the fw3 teardown (stop marker present)"
            exit 0
        fi
        exec 9>"$NYM_RUNTIME_DIR/lock"
        flock 9 || {
            logger -t nym-vpn "flock failed on $NYM_RUNTIME_DIR/lock; the next firewall reload performs the fw3 teardown (stop marker present)"
            exit 0
        }
        export NYM_FW_LOCKED=1
        # Files a pre-runtime-directory daemon left under /tmp; never read.
        rm -f /tmp/nym-firewall-v4.rules /tmp/nym-firewall-v6.rules \
            /tmp/nym-firewall.ifaces /tmp/nym-firewall.transition \
            /tmp/nym-firewall.lock /tmp/nym-vpnd.stopped /tmp/nym-vpnd.stop-pid 2>/dev/null
        if [ "$(nym_fw_backend)" = "fw3" ] \
            && iptables -L input_rule -n >/dev/null 2>&1; then
            "$NYM_SHARE_DIR/fw3-include.sh" 2>/dev/null || true
        fi
    )
}
