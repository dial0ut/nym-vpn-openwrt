#!/bin/sh /etc/rc.common
START=90
STOP=10
USE_PROCD=1

# Written on explicit stop, cleared on start (contract with fw-boot-guard.sh).
# While present, a firewall reload must not re-install the boot-time
# kill-switch block: the administrator asked for their network back and no
# daemon is coming to lift it. /tmp is tmpfs, so a reboot re-arms the block.
STOPPED_MARKER=/tmp/nym-vpnd.stopped

# Only an explicit `stop` opens the network. A `restart` — which is also
# how a package upgrade swaps the daemon (postinst restarts through this
# script) — leaves the kill-switch armed for the gap: the daemon keeps its
# Blocked policy in place on shutdown while the kill-switch is on, and the
# next daemon replaces it atomically on its first apply. rc.common runs
# `restart` as the stop and start functions of one process, so $action is
# still "restart" in the stop hooks.
keep_killswitch() {
    # shellcheck disable=SC2154  # action is set by rc.common
    [ "$action" = "restart" ]
}

start_service() {
    rm -f "$STOPPED_MARKER"

    # Kill-switch firewall integration needs fw4's table present; if the
    # firewall service exists but its table isn't up yet, nudge it first.
    # That reload also runs the include, which arms the boot-time block if
    # the kill-switch is on — closing the gap until the daemon's first policy.
    if [ -x /etc/init.d/firewall ] && ! nft list table inet fw4 >/dev/null 2>&1; then
        /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
    mkdir -p /etc/nym/data
    procd_open_instance
    procd_set_param command /usr/sbin/nym-vpnd
    # retry=0: respawn forever. The daemon owns the fail-closed kill-switch
    # table (inet nym); if procd gives up on a crash-looping daemon, the
    # router is left blackholed with no process able to clear it.
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/nym-vpnd.pid
    procd_close_instance
}

STOP_PID_STASH=/tmp/nym-vpnd.stop-pid

stop_service() {
    # First thing, before anything can fail or block: a reload racing this
    # stop must already see the marker.
    keep_killswitch || touch "$STOPPED_MARKER" 2>/dev/null

    # Stash the daemon pid before procd kills it: service_stopped() needs
    # it, and pidof is useless there — rc.common itself runs with comm
    # "nym-vpnd" and would match.
    cat /var/run/nym-vpnd.pid 2>/dev/null > "$STOP_PID_STASH"

    # Graceful disconnect, guarded: a hung daemon accepts the control
    # socket but never replies, and an unguarded nym-vpnc wedges stop
    # forever (BusyBox ships no timeout(1)). Give it 10s, then move on —
    # procd_kill and service_stopped() handle the rest.
    /usr/bin/nym-vpnc disconnect 2>/dev/null &
    local vpnc=$! i=0
    while kill -0 "$vpnc" 2>/dev/null && [ "$i" -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    kill -9 "$vpnc" 2>/dev/null
    return 0
}

service_stopped() {
    # Runs after procd has killed the daemon. A dead or hung daemon cannot
    # answer the disconnect above, and the kill-switch table outlives the
    # process — without this the router stays blackholed (WAN egress and
    # LAN forwarding blocked) with nothing left to open the firewall.
    # An explicit stop means the admin wants their network back.
    #
    # procd's kill is asynchronous: the daemon may still be shutting down
    # (re-asserting its Blocked policy on the way out) when this hook runs.
    # Wait for the stashed pid to really exit — SIGKILL lands after
    # term_timeout (5s), so the loop terminates well inside its bound. The
    # cmdline check guards against pid reuse and a stale stash.
    local pid i=0
    pid="$(cat "$STOP_PID_STASH" 2>/dev/null)"
    rm -f "$STOP_PID_STASH"
    while [ -n "$pid" ] && grep -q nym-vpnd "/proc/$pid/cmdline" 2>/dev/null \
        && [ "$i" -lt 20 ]; do
        sleep 1
        i=$((i + 1))
    done

    # Restart or upgrade: the kill-switch stays armed. The daemon left its
    # policy (fw4: inet nym; fw3: chains plus the persisted rules files), a
    # boot block that may exist is lifted by the next daemon's first apply,
    # and a reload meanwhile finds no stop marker and keeps the block. If
    # the new daemon never comes up, `stop` is what opens the router.
    if keep_killswitch; then
        logger -t nym-vpn "nym-vpnd $action: leaving the kill-switch armed"
        return 0
    fi

    nft delete table inet nym 2>/dev/null || true
    # The boot-time block (fw4-include.sh) would otherwise outlive the daemon
    # that was supposed to lift it; the stop marker keeps reloads from
    # re-installing it until the next start.
    nft delete table inet nym_boot 2>/dev/null || true

    # fw3 (iptables) routers: the kill-switch chains live in the shared
    # filter/mangle/nat tables and outlive the daemon just like the nft
    # table does. Remove the daemon's persisted ruleset, then let the
    # include script's cleanup branch tear the chains down — the same code
    # path a firewall reload takes, so stop and reload can't diverge.
    # Removing the transition marker is explicit-stop authorization to open;
    # a crash leaves it intact so fw3 reloads stay emergency-blocked.
    # Done under the fw3 state lock the daemon and the include share, so a
    # firewall reload cannot observe the files half-removed; the include is
    # told the lock is already held (re-taking it would deadlock).
    (
        if command -v flock >/dev/null 2>&1; then
            exec 9>/tmp/nym-firewall.lock
            flock 9 || true
            export NYM_FW_LOCKED=1
        fi
        rm -f /tmp/nym-firewall-v4.rules /tmp/nym-firewall-v6.rules \
            /tmp/nym-firewall.ifaces /tmp/nym-firewall.transition 2>/dev/null
        if [ -x /usr/share/nym-vpn/fw-backend.sh ] \
            && [ "$(/usr/share/nym-vpn/fw-backend.sh)" = "fw3" ] \
            && iptables -L input_rule -n >/dev/null 2>&1 \
            && [ -x /usr/share/nym-vpn/fw3-include.sh ]; then
            /usr/share/nym-vpn/fw3-include.sh 2>/dev/null || true
        fi
    )
}
