# Wakes the always-on watchdog (SIGUSR1 = up, SIGUSR2 = down) when a
# WAN-facing interface changes state. Sourced by hotplug-call.

[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ] || exit 0
[ -n "$INTERFACE" ] || exit 0
[ "$INTERFACE" != "loopback" ] || exit 0

[ "$(uci -q get nym-vpn.settings.always_on)" = "1" ] || exit 0
pid="$(cat /var/run/nym-vpn-watchdog.pid 2>/dev/null)"
case "$pid" in
    ''|*[!0-9]*) exit 0 ;;
esac
# An untrapped SIGUSR1/2 kills its target; guard against pid reuse.
grep -q "nym-vpn-watchdog" "/proc/$pid/cmdline" 2>/dev/null || exit 0

. /lib/functions.sh
. /lib/functions/network.sh

# wan/wan6, any member of the "wan" firewall zone, or an interface with a
# default route (only detectable on ifup; on ifdown the route is gone).
in_wan_zone=0
check_zone() {
    local name networks
    config_get name "$1" name
    [ "$name" = "wan" ] || return 0
    config_get networks "$1" network
    case " $networks " in
        *" $INTERFACE "*) in_wan_zone=1 ;;
    esac
}

is_wan_facing() {
    local gw
    case "$INTERFACE" in
        wan|wan6) return 0 ;;
    esac
    config_load firewall
    config_foreach check_zone zone
    [ "$in_wan_zone" = "1" ] && return 0
    network_get_gateway gw "$INTERFACE" && [ -n "$gw" ] && return 0
    network_get_gateway6 gw "$INTERFACE" && [ -n "$gw" ] && return 0
    return 1
}

is_wan_facing || exit 0

logger -t nym-watchdog "$ACTION $INTERFACE${DEVICE:+ ($DEVICE)}, waking watchdog"
if [ "$ACTION" = "ifup" ]; then
    kill -USR1 "$pid" 2>/dev/null
else
    kill -USR2 "$pid" 2>/dev/null
fi
exit 0
